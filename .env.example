# Transport
ML3ERROR_TRANSPORT=telegram
ML3ERROR_TRANSPORT_TOKEN=1234567890:ABCdef-your-bot-token-here
ML3ERROR_TRANSPORT_CHAT_ID=123456789

# Optional: override the default SQLite state path.
# ML3ERROR_STATE=sqlite:///./.ml3error.db
# ML3ERROR_STATE=redis://localhost:6379/0

# Optional project-identification settings.
